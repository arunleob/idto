<?xml version="1.0"?>
<robot name="sphere">
  <material name="green">
    <color rgba=".3 .6 .4 1"/>
  </material>
  <material name="red">
    <color rgba=".9 .1 0 0.1"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.3 0.5 1"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 0.1"/>
  </material>

  <!-- sphere x-axis -->
  <link name="sphere_x">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0.0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.0"/>
    </inertial>
  </link>
  <joint name="sphere_x" type="prismatic">
    <parent link="world"/>
    <child link="sphere_x"/>
    <origin xyz="0 0 0" rpy="0 0 0 "/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- sphere y-axis -->
  <link name="sphere_y">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0.0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.0"/>
    </inertial>
  </link>
  <joint name="sphere_y" type="prismatic">
    <parent link="sphere_x"/>
    <child link="sphere_y"/>
    <origin xyz="0 0 0" rpy="0 0 0 "/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- sphere z-axis-->
  <link name="sphere">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="sphere_z" type="prismatic">
    <parent link="sphere_y"/>
    <child link="sphere"/>
    <origin xyz="0 0 0" rpy="0 0 0 "/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0"/>
  </joint>

  <!-- second sphere contact point-->
  <link name="sphere2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="sphere2_weld" type="fixed">
    <parent link="sphere"/>
    <child link="sphere2"/>
    <origin xyz="0.1 0.1 0" rpy="0 0 0 "/>
  </joint>

  <!-- third sphere contact point-->
  <link name="sphere3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="sphere3_weld" type="fixed">
    <parent link="sphere"/>
    <child link="sphere3"/>
    <origin xyz="0.1 -0.1 0" rpy="0 0 0 "/>
  </joint>

  <transmission type="SimpleTransmission" name="sphere_x_trans">
    <actuator name="sphere_x"/>
    <joint name="sphere_x"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>
  <transmission type="SimpleTransmission" name="sphere_y_trans">
    <actuator name="sphere_y"/>
    <joint name="sphere_y"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>
  <transmission type="SimpleTransmission" name="sphere_z_trans">
    <actuator name="sphere_z"/>
    <joint name="sphere_z"/>
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

</robot>
